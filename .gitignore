# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Production
/dist

# Generated / derived
next-env.d.ts
*.tsbuildinfo

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Deployment
.vercel

# Testing
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local tooling — .claude/launch.json holds an absolute path to this machine's
# node.exe, so it is not portable to another checkout.
/.claude/

# Certificates and keys
*.pem
*.key
